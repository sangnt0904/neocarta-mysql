# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=12345677
NEO4J_DATABASE=neo4j

# MySQL
JDBC_URL=jdbc:mysql://<host>:<port>/<database>
JDBC_USER=<user>
JDBC_PASSWORD=<password>
JDBC_DRIVER=com.mysql.cj.jdbc.Driver
JDBC_DRIVER_JAR=./drivers/ysql-connector-j-26.7.0.jar
SCHEMACRAWLER_JAR=./schemacrawler-16.26.3-bin/lib/*

# Agent
AGENT_MODEL=openai/gpt-oss-120b
FPT_BASE_URL=https://mkp-api.fptcloud.com/v1
FPT_API_KEY=<API_key>
MYSQL_URL=mysql+pymysql://<user>:<password>@<host>:<port>/<database>
